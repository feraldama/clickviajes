# ──────────────────────────────────────────────────────────────
# Click Viajes — plantilla de variables de entorno
# Copiar a .env y completar con valores reales:  cp .env.example .env
# ──────────────────────────────────────────────────────────────

# ───── Base de datos (PostgreSQL) ─────
DATABASE_URL="postgresql://USUARIO:CONTRASENA@localhost:5432/clickviajes?schema=public"

# ───── API (Express) ─────
NODE_ENV=development
API_PORT=3015
# Uno o varios orígenes permitidos por CORS, separados por comas (sin barra final).
CORS_ORIGIN=http://localhost:3016

# ───── Autenticación (JWT) ─────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
BCRYPT_ROUNDS=10

# ───── Frontend (Next.js) ─────
NEXT_PUBLIC_API_URL=http://181.123.61.216:3015
